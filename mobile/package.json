{
  "name": "memoir-mobile",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "npm --prefix ../app run build",
    "prepare:model": "node scripts/prepare-mobile-model.mjs",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios --packagemanager SPM",
    "cap:sync": "npm run build:web && npx cap sync && node scripts/configure-ios-runtime.mjs",
    "bootstrap:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-android-toolchain.ps1",
    "build:android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-debug.ps1",
    "verify:android:debug": "node scripts/verify-android-apk.mjs --apk mobile/android/app/build/outputs/apk/debug/app-debug.apk --abi arm64-v8a --build-type debug",
    "smoke:android:device": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-android-device-acceptance.ps1",
    "smoke:android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-android-device-acceptance.ps1 -BuildType Release",
    "build:android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-release.ps1",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1"
  }
}
